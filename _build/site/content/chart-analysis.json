position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"kW6qgStV5x"}],"key":"qt7R513W1n"}],"key":"GqMuXpIv8V"},{"type":"image","url":"/reported_fig1-790cd40c874b0e30fbb25b4aa290536b.png","alt":"original figure 1","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"uwxrWpHUSz","urlSource":"../visualizations/descriptive_charts/reported_fig1.png"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"The original report generated this figure using individual-level data, where each observation represents a single Californian. With this structure, they were able to assign each person a CalEnviroScreen 4.0 percentile score based on their census tract and then group individuals by race/ethnicity to compute the accurate score distribution for each group.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"abZulfZx7b"}],"key":"j9dIpU37id"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"However, our dataset is at the county level. While we had the total population data, generating the long-format dataset by repeatedly appending observations was avoided due to high time consumption. Thus we approximately generated the boxplot by assigning each county to the race/ethnicity group with the highest proportion.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"xKyw9BfiE0"}],"key":"rrPb3N8yWC"}],"key":"WcQNqSq7F9"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2025-12-18T04:40:48.469462Z","iopub.status.busy":"2025-12-18T04:40:48.469385Z","iopub.status.idle":"2025-12-18T04:40:48.617346Z","shell.execute_reply":"2025-12-18T04:40:48.616919Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"df.loc[:, 'major_race'] = df[race_cols].idxmax(axis=1)\nmedian = df.groupby('major_race')['CIscoreP'].median().sort_values()\nmedian_order = median.index\nsns.boxplot(data= df, x='major_race', y='CIscoreP', order= median_order, palette=\"Set1\", hue = 'major_race', legend=False)\nplt.title('CalEnviroScreen 4.0 Percentile Scores by Majority Race/Ethnicity')\nfor tick, label in enumerate(median_order):\n    median_value = median[label]\n    plt.text(tick, median_value+2, f'{median_value:.1f}', horizontalalignment='center')\n\nplt.savefig(\"../visualizations/descriptive_charts/fig1_majorityrace_BaW.png\", dpi=300, bbox_inches=\"tight\")","key":"h9LQ5B7Jgh"},{"type":"outputs","id":"tmBmBUN-iqj26cnU9qeh5","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"/var/folders/0k/jn4h9ptx7_500msv80bg_rcm0000gn/T/ipykernel_9804/928823105.py:1: FutureWarning: The behavior of DataFrame.idxmax with all-NA values, or any-NA and skipna=False, is deprecated. In a future version this will raise ValueError\n  df.loc[:, 'major_race'] = df[race_cols].idxmax(axis=1)\n"},"children":[],"key":"kaNEigdd8S"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"15e720d8e979dd898ccb73cdff7f51ec","path":"/15e720d8e979dd898ccb73cdff7f51ec.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"SPhUOzwUQ9"}],"key":"OaMScJiV2f"}],"key":"KunupGRGn1"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2025-12-18T04:40:48.618572Z","iopub.status.busy":"2025-12-18T04:40:48.618470Z","iopub.status.idle":"2025-12-18T04:40:48.621158Z","shell.execute_reply":"2025-12-18T04:40:48.620821Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"df['major_race'].value_counts()","key":"KPOfT3rOcj"},{"type":"outputs","id":"SGauDD1FoLtFxb3z7SnSS","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":7,"metadata":{},"data":{"text/plain":{"content":"major_race\nWhite        3853\nHispanic     3279\nAAPI          763\nAfricanAm     112\nNativeAm        4\nName: count, dtype: int64","content_type":"text/plain"}}},"children":[],"key":"TVGfNSeGRO"}],"key":"vRGmqEPG1w"}],"key":"FNr0ipVOHO"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The comparison between the original figure 1 and the reproduced analysis confirms the severe structural environment injustice in California. The African American (corresponding to Black) and Hispanic (corresponding to Latino) groups shows the consistently highest median vulnerability score, and the White group shows the lowest. This indicates that Hispanic and African American populations tend to live in communities with higher pollution burdens and vulnerabilities than the other/racial/ethnic groups analyzed. ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"P0i5MSI6VN"},{"type":"break","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"AV3EkuRjh3"},{"type":"break","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wt1lZmpqVU"},{"type":"text","value":"However, the methodology used for the reproduction seemingly inflated the median scores significantly compared to the original report. Also, the extremely low count for the Native American group (n=4) makes its derived median unreliable for comparison purposes.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"craRzwXBaN"}],"key":"cs0ZNliL4x"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"strong","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Figure 2. Race in the Least and Most Impacted Census Tracts of CalEnviroScreen 4.0.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"UBHLjSZZpl"}],"key":"gn1XH6DURS"}],"key":"XWtnHoI8XT"},{"type":"image","url":"/reported_fig2-2742ba030148bf2a554ed00c076dd4c3.png","alt":"original figure 2","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"h0hyBfkOFj","urlSource":"../visualizations/descriptive_charts/reported_fig2.png"}],"key":"bK2vK5fuk5"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2025-12-18T04:40:48.622525Z","iopub.status.busy":"2025-12-18T04:40:48.622430Z","iopub.status.idle":"2025-12-18T04:40:48.719511Z","shell.execute_reply":"2025-12-18T04:40:48.719079Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"bottom = df[df['CIscoreP'] <= 10]\ntop = df[df['CIscoreP'] >= 90]\n\nbottom_white = bottom['White'].mean()\nbottom_poc = 100 - bottom_white\n\ntop_white = top['White'].mean()\ntop_poc = 100 - top_white\n\nlabels = ['White', 'People of Color']\nbottom_sizes = [bottom_white, bottom_poc]\ntop_sizes = [top_white, top_poc]\n\nfig, ax = plt.subplots(1, 2, figsize = (10, 5))\nax[0].pie(bottom_sizes, labels=labels, autopct='%1.1f%%', startangle=90)\nax[0].set_title('10% least impacted neighborhoods')\nax[1].pie(top_sizes, labels=labels, autopct='%1.1f%%', startangle=90)\nax[1].set_title('10% most impacted neighborhoods')\n\nplt.savefig(\"../visualizations/descriptive_charts/fig2_topbottom_piechart.png\", dpi=300, bbox_inches=\"tight\")","key":"dtEkqd7Apg"},{"type":"outputs","id":"g-M0m2rqWG4GMj7VdW09x","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"6c82811389e4a56de6dae3b6a62ea03f","path":"/6c82811389e4a56de6dae3b6a62ea03f.png"},"text/plain":{"content":"<Figure size 1000x500 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"HVXt7HwRRX"}],"key":"yngXUk4c5D"}],"key":"SL7uA3WFz3"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Figure 3. Racial Makeup of Each Decile of CalEnviroScreen 4.0 Score.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EbsZt0b9ld"}],"key":"DiMIF4CDO4"}],"key":"MEjOQnkTuP"},{"type":"image","url":"/reported_fig3-b6283b14e3d92863a4bfc5e6b1e2e9c8.png","alt":"original figure 3","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"AcvSu2IrWr","urlSource":"../visualizations/descriptive_charts/reported_fig3.png"}],"key":"emh4HXV9DE"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2025-12-18T04:40:48.720734Z","iopub.status.busy":"2025-12-18T04:40:48.720653Z","iopub.status.idle":"2025-12-18T04:40:48.920788Z","shell.execute_reply":"2025-12-18T04:40:48.920319Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"df['decile'] = pd.qcut(df['CIscoreP'], 10, labels=False) + 1\ndecile_means = df.groupby('decile')[race_cols].mean()\ndecile_means.index = list(range(1, 11))\nca_means = df[race_cols].mean()\nca_df = ca_means.to_frame().T\nca_df.index = ['CA']\ndf_plot = pd.concat([decile_means, ca_df], axis=0)\n\nplot_order = ['White', 'Hispanic', 'AAPI', 'AfricanAm', 'OtherMult', 'NativeAm']\n\nfig, ax = plt.subplots(figsize=(10, 8))\ndf_plot[plot_order].plot(kind='barh', stacked=True, ax=ax)\nax.set_ylabel('CalEnviroScreen 4.0 Decile \\n<- Increasing Disadvantage')\nax.invert_yaxis()\nax.legend(loc='lower center', bbox_to_anchor = (0.5, -0.15), ncol = 6)\nplt.title('Racial Makeup of Each Decile of CalEnviroScreen 4.0 Score')\n\nplt.savefig(\"../visualizations/descriptive_charts/fig3_racialmakeupbydecile_barchart.png\", dpi=300, bbox_inches=\"tight\")","key":"zCkBmPSxoM"},{"type":"outputs","id":"vMMua_0lchh6RsUx9-b_T","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"6ca1af780efa2d488f342f1ad3b4778a","path":"/6ca1af780efa2d488f342f1ad3b4778a.png"},"text/plain":{"content":"<Figure size 1000x800 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"aPBEH6Gp94"}],"key":"gOeiDA0u31"}],"key":"kiPuK8CQGS"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"The results are consistent with the original conclusions, reaffirming the environmental racial inequity within California.\nAs environmental vulnerability increases (moving to higher deciles), the proportion of Hispanic and African American residents increases overwhelmingly. Conversely, the proportion of White residents decreases sharply as the disadvantage lessens, suggesting they predominantly reside in the most environmentally safe areas. This inequality is further highlighted when compared to the average bar representing the entire state of California at the bottom.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oIIoyWietO"}],"key":"hVHqv47BMl"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"strong","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Figure 4. Most prevalent race by census tracts were overlaid with most disadvantaged 10%\nCalEnviroScreen scores.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"tpvPH4rRSx"}],"key":"cOauwE70Pm"}],"key":"Q0E2fkz5It"},{"type":"image","url":"/reported_fig4-5ab746d5223a9ba32f6d9d3289b575d4.png","alt":"original figure 4","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"QS7Mf3BPah","urlSource":"../visualizations/descriptive_charts/reported_fig4.png"}],"key":"ctMlax7IpC"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2025-12-18T04:40:48.921983Z","iopub.status.busy":"2025-12-18T04:40:48.921901Z","iopub.status.idle":"2025-12-18T04:40:48.924934Z","shell.execute_reply":"2025-12-18T04:40:48.924554Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"top_counts = top['major_race'].value_counts()\ntotal_counts = df['major_race'].value_counts()\ntop_counts, total_counts","key":"fj0nBHlnHJ"},{"type":"outputs","id":"8QYbXgMwqRsspmQ0FQgU9","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":10,"metadata":{},"data":{"text/plain":{"content":"(major_race\n Hispanic     745\n AfricanAm     21\n White         19\n AAPI           9\n Name: count, dtype: int64,\n major_race\n White        3853\n Hispanic     3279\n AAPI          763\n AfricanAm     112\n NativeAm        4\n Name: count, dtype: int64)","content_type":"text/plain"}}},"children":[],"key":"kmV9y2UrQJ"}],"key":"TqawleQb7z"}],"key":"jeRbbM2T52"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2025-12-18T04:40:48.926015Z","iopub.status.busy":"2025-12-18T04:40:48.925936Z","iopub.status.idle":"2025-12-18T04:40:49.012583Z","shell.execute_reply":"2025-12-18T04:40:49.012062Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"top_ratio = (top_counts / total_counts).sort_values(ascending=True) * 100\nplt.barh(top_ratio.index, top_ratio.values, height=0.5, color=sns.color_palette(\"Set1\"))\nfor i, v in enumerate(top_ratio.values):\n    plt.text(v, i, f'{v:.1f}%', va='center')\nplt.title(\"Percent of Each Racial/Ethnic Group's Most \\n Prevalent Census Tracts That are in the Highest \\n 10% of Scoring Communities\")\n\nplt.savefig(\"../visualizations/descriptive_charts/fig4_top10perctracts_barchart.png\", dpi=300, bbox_inches=\"tight\")","key":"fPZzmw6KLv"},{"type":"outputs","id":"oGg8D8nazF31G2i87JQHb","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"59fd9abfdd533dca797065b5e5c0b4b2","path":"/59fd9abfdd533dca797065b5e5c0b4b2.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"BuPsUcH2q6"}],"key":"uBFtAGToHc"}],"key":"QBK639unxN"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We were able to reproduce the exact same numerical values as the original report. Although the proportion of African Americans appears small in Figure 3, the fact that 18% of counties where African Americans are the major racial group are environmentally vulnerable (21 out of 112 counties) is not that different from the Hispanic proportion. This shows why attention should be paid not only to Hispanics but also to African Americans.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cThWUlZF5u"}],"key":"wVXj4qWY8S"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Additional Analysis","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"NznpT16H6S"}],"key":"ixoXqby9EO"}],"key":"Mb0hLtUhZq"}],"key":"iuxB24NziM"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2025-12-18T04:40:49.013860Z","iopub.status.busy":"2025-12-18T04:40:49.013769Z","iopub.status.idle":"2025-12-18T04:40:49.030388Z","shell.execute_reply":"2025-12-18T04:40:49.030036Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def select_high_correlated_vars(df, race_cols, threshold = 0.6):\n    corr = df.drop(['major_race'], axis = 1).corr()\n    vars = pd.DataFrame()\n    for race_col in race_cols:\n        race_corr = corr[race_col].drop(race_cols)\n        selected = race_corr[abs(race_corr) > threshold].sort_values(ascending=False)\n        vars = pd.concat([vars, selected], axis=1)\n    return vars\n\nselect_high_correlated_vars(df, race_cols)","key":"G9yx4iy8Rj"},{"type":"outputs","id":"AeqHgSKyhiFQnM4JBCtUL","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":12,"metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Hispanic</th>\n      <th>White</th>\n      <th>AfricanAm</th>\n      <th>NativeAm</th>\n      <th>OtherMult</th>\n      <th>AAPI</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>EducatP</th>\n      <td>0.853965</td>\n      <td>-0.775303</td>\n      <td>NaN</td>\n      <td>NaN</td>\n      <td>NaN</td>\n      <td>NaN</td>\n    </tr>\n    <tr>\n      <th>CIscoreP</th>\n      <td>0.741219</td>\n      <td>-0.725284</td>\n      <td>NaN</td>\n      <td>NaN</td>\n      <td>NaN</td>\n      <td>NaN</td>\n    </tr>\n    <tr>\n      <th>decile</th>\n      <td>0.738075</td>\n      <td>-0.720705</td>\n      <td>NaN</td>\n      <td>NaN</td>\n      <td>NaN</td>\n      <td>NaN</td>\n    </tr>\n    <tr>\n      <th>PopCharP</th>\n      <td>0.729622</td>\n      <td>-0.713956</td>\n      <td>NaN</td>\n      <td>NaN</td>\n      <td>NaN</td>\n      <td>NaN</td>\n    </tr>\n    <tr>\n      <th>PovertyP</th>\n      <td>0.675304</td>\n      <td>NaN</td>\n      <td>NaN</td>\n      <td>NaN</td>\n      <td>NaN</td>\n      <td>NaN</td>\n    </tr>\n    <tr>\n      <th>Ling_IsolP</th>\n      <td>0.607499</td>\n      <td>-0.753909</td>\n      <td>NaN</td>\n      <td>NaN</td>\n      <td>NaN</td>\n      <td>NaN</td>\