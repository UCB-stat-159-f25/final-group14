ite = top['White'].mean()\ntop_hispanic = top['Hispanic'].mean()\ntop_poc = 100 - top_white - top_hispanic\n\nlabels = ['White', 'Hispanic', 'Other People of Color']\nbottom_sizes = [bottom_white, bottom_hispanic, bottom_poc]\ntop_sizes = [top_white, top_hispanic, top_poc]\n\nfig, ax = plt.subplots(1, 2, figsize = (10, 5))\nax[0].pie(bottom_sizes, labels=labels, autopct='%1.1f%%', startangle=90)\nax[0].set_title('10% lowest poverty rates neighborhoods')\nax[1].pie(top_sizes, labels=labels, autopct='%1.1f%%', startangle=90)\nax[1].set_title('10% lowest education neighborhoods')\n\nplt.savefig(\"../visualizations/descriptive_charts/fig5_topbottom_educatP_piechart.png\", dpi=300, bbox_inches=\"tight\")","key":"fjSCPGEKhb"},{"type":"outputs","id":"shBASxzIjkxCft41Q7skW","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"f4408f29a54f14f60eebbbb10878e0e6","path":"/f4408f29a54f14f60eebbbb10878e0e6.png"},"text/plain":{"content":"<Figure size 1000x500 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"gszxQcR7U5"}],"key":"vVM57R4rF1"}],"key":"eUIB7iQEVQ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In the 10% lowest education neighborhoods, the Hispanic population accounts for an average of 82%. This concentration is notably stronger than in neighborhoods grouped by other variables.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZoVGTTPxg1"}],"key":"Ka5WJZcuw2"}],"key":"Gf3jL1DMQC"}],"key":"f2r471PEEF"},"references":{"cite":{"order":[],"data":{}}}}