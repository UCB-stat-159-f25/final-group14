    "# Import and clean the data\n",
    "df_raw = pd.read_csv('data/calenviroscreen40.csv')\n",
    "\n",
    "df_clean = clean_data(df_raw)\n",
    "X = df_clean[df_clean.notna().all(axis=1)]\n",
    "feature_cols = X.columns.tolist()\n"
   ]
  },
